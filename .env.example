# Where the Knowledge Base REST API lives.
# Inside the plusgpt.io deployment the backend is a sibling container:
KB_API_URL=http://backend:8000/api/v1
# From a laptop, point it at the public API instead:
# KB_API_URL=https://plusgpt.io/api/v1

# How this server is served. Behind the reverse proxy only the path matters.
HOST=0.0.0.0
PORT=8000
MCP_PATH=/mcp

# Public URL of this MCP endpoint, advertised to clients that ask.
# PUBLIC_URL=https://plusgpt.io/mcp

# Ordinary calls vs. answering and document parsing, which take far longer.
KB_TIMEOUT_SECONDS=120
KB_LONG_TIMEOUT_SECONDS=600

# A verified API key is trusted this long before it is checked again.
AUTH_CACHE_SECONDS=300

# Upper bound on how long a tool will block waiting for an import or an index.
MAX_WAIT_SECONDS=540

# This server stores no credentials of its own. Callers authenticate with their
# own Knowledge Base API key, sent as `Authorization: Bearer kb_...`.
